# Copy to .env and fill in. Never commit .env — it holds live API keys.

# --- Sendcloud -------------------------------------------------------------
# Panel > Settings > Integrations > Sendcloud API
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# The Shopify integration the orders come in through. Panel > Settings >
# Integrations > (your shop); the id is the number in the URL.
SENDCLOUD_INTEGRATION_ID=
SENDCLOUD_API_BASE=https://panel.sendcloud.sc/api

# --- Label format ----------------------------------------------------------
# application/pdf for a normal or A6 label printer, application/zpl for a Zebra.
LABEL_MIME_TYPE=application/pdf
LABEL_DPI=203

# --- Printing --------------------------------------------------------------
# sendcloud_client | cups | none
PRINT_BACKEND=sendcloud_client
# The machine running the Sendcloud Print Client. Leave as localhost when the
# Print Client runs on this same box.
PRINT_CLIENT_URL=http://127.0.0.1:1903
# Run `curl http://127.0.0.1:1903/printers` (or GET /api/printers on this app)
# once to find the id of the label printer.
PRINT_CLIENT_PRINTER_ID=
# Only used when PRINT_BACKEND=cups
CUPS_PRINTER=
SPOOL_DIR=/var/tmp/label-scanner

# --- Behaviour -------------------------------------------------------------
# Number of parcel-count buttons on the touch screen.
MAX_PARCELS=6
# true = fake orders and labels, nothing is sent to Sendcloud. Use this to test
# the touch screen and the scanner before going live.
DEMO_MODE=false
