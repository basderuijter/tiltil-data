[Unit]
Description=TILTIL label scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/tiltil-data/apps/label-scanner
EnvironmentFile=/home/pi/tiltil-data/apps/label-scanner/.env
ExecStart=/home/pi/tiltil-data/apps/label-scanner/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
