# Kopieer naar .env of zet als omgevingsvariabelen bij het starten.

# --- SRS-koppeling ---
# mock = demodata uit fixtures/srs_demo.json, rest = de echte webservice
SRS_BACKEND=mock
SRS_BASE_URL=
SRS_AUTH_TYPE=none          # none | basic | bearer | header
SRS_USERNAME=
SRS_PASSWORD=
SRS_TOKEN=
SRS_API_KEY_HEADER=X-Api-Key
SRS_TIMEOUT=20
SRS_VERIFY_SSL=true
SRS_MAPPING_FILE=config/srs_rest.json
SRS_FIXTURE_FILE=fixtures/srs_demo.json

# --- Opslag ---
PH_DB=data/controles.db

# --- Plattegrond van de hal ---
# Laat weg om de indeling af te leiden uit de PH-codes uit SRS.
HAL_INDELING=config/hal.json

# --- Signalering ---
PH_LETOP_UREN=4          # daarna kleurt een PH 'let op'
PH_VASTLOPER_UREN=24     # daarna is het een vastloper
PH_STILSTAND_UREN=8      # zo lang geen voortgang = ook vastloper

# --- Snelheid ---
PH_SNELMODUS=true        # laatste scan geeft zelf akkoord en print de pakbon
PH_AUTO_START=true       # complete PH openen start de controle meteen

# --- Sendcloud en labels ---
# Zonder sleutels slaat de app de labelstap over; met VERZENDING_DEMO=true
# draait de hele keten op nepdata.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
SENDCLOUD_INTEGRATION_ID=      # id van de Shopify-integratie in Sendcloud
SENDCLOUD_API_BASE=https://panel.sendcloud.sc/api
SENDCLOUD_TIMEOUT_SECONDS=30
LOOKUP_RETRY_SECONDS=6         # orders worden asynchroon opgeslagen
LABEL_MIME_TYPE=application/pdf # of application/zpl voor een Zebra
LABEL_DPI=72                   # pdf: 72, png: 150 of 300, zpl: genegeerd
APPLY_SHIPPING_RULES=false
CONTRACT_ID=                   # leeg = standaardcontract per vervoerder
SHIPPING_OPTIONS_FILE=config/shipping-options.example.json
STANDAARD_VERZENDMETHODE=      # bijv. postnl:standard, als de order er geen heeft
GIFTCARD_PATROON=giftcard|gift card|cadeaubon|kadobon|e-?voucher
VERZENDING_DEMO=false

# --- Printen ---
PRINT_BACKEND=sendcloud_client # sendcloud_client | cups | none
PRINT_CLIENT_URL=http://127.0.0.1:1903
PRINT_CLIENT_PRINTER_ID=
CUPS_PRINTER=
STATIONS_FILE=                 # meerdere PH-tafels: zie config/stations.example.json
STATION_ID=                    # welke tafel deze machine is
SPOOL_DIR=/var/tmp/ph-labels

# --- Gegevens op de pakbon ---
BEDRIJF_NAAM=Things I Like Things I Love
BEDRIJF_ADRES=
BEDRIJF_PLAATS=
BEDRIJF_EMAIL=info@thingsilikethingsilove.com
BEDRIJF_SITE=www.thingsilikethingsilove.com
BEDRIJF_BTW=
