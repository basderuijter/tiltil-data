# Kopieer naar .env of zet als omgevingsvariabelen bij het starten.

# --- SRS-koppeling ---
# mock = demodata uit fixtures/srs_demo.json, rest = de echte webservice
SRS_BACKEND=mock
SRS_BASE_URL=
SRS_AUTH_TYPE=none          # none | basic | bearer | header
SRS_USERNAME=
SRS_PASSWORD=
SRS_TOKEN=
SRS_API_KEY_HEADER=X-Api-Key
SRS_TIMEOUT=20
SRS_VERIFY_SSL=true
SRS_MAPPING_FILE=config/srs_rest.json
SRS_FIXTURE_FILE=fixtures/srs_demo.json

# --- Opslag ---
PH_DB=data/controles.db

# --- Gegevens op de pakbon ---
BEDRIJF_NAAM=Things I Like Things I Love
BEDRIJF_ADRES=
BEDRIJF_PLAATS=
BEDRIJF_EMAIL=info@thingsilikethingsilove.com
BEDRIJF_SITE=www.thingsilikethingsilove.com
BEDRIJF_BTW=
